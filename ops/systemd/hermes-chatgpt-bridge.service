[Unit]
Description=Hermes ChatGPT inference bridge and MCP tunnel
Wants=network-online.target hermes-chatgpt-electron.service
After=network-online.target hermes-chatgpt-electron.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
Environment=HOME=/home/ubuntu
# hermes serve performs launcher liveness validation itself. Do not run the full
# authenticated browser inspection here: the shared Electron host may be healthy but busy
# serving an independent Codex turn, and startup must not fail merely because that turn is active.
ExecStart=/home/ubuntu/hermes-chatgpt-runtime/bin/codex-chatgpt-web hermes serve
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=30
KillMode=control-group

[Install]
WantedBy=multi-user.target
