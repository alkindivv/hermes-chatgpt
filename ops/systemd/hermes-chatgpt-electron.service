[Unit]
Description=Hermes ChatGPT remote Electron browser host
Wants=network-online.target hermes-chatgpt-xvfb.service
After=network-online.target hermes-chatgpt-xvfb.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
Environment=HOME=/home/ubuntu
Environment=DISPLAY=:99
Environment=CODEX_CHATGPT_WEB_REMOTE_BROWSER_HOST_ONLY=1
ExecStart=/home/ubuntu/codex-web-gpt-hermes.AppImage
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillMode=control-group

[Install]
WantedBy=multi-user.target
