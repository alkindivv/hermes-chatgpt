diff --git a/crates/gpui-cef/src/platform/cef/mod.rs b/crates/gpui-cef/src/platform/cef/mod.rs
index aa45e00..c4f1fc4 100644
--- a/crates/gpui-cef/src/platform/cef/mod.rs
+++ b/crates/gpui-cef/src/platform/cef/mod.rs
@@ -400,6 +400,15 @@ impl Webview {
         }
     }
 
+    /// Browser zoom without reading or changing page DOM.
+    pub fn set_zoom_factor(&self, factor: f64) {
+        if factor.is_finite() && (0.5..=2.0).contains(&factor) {
+            if let Some(host) = self.host() {
+                host.set_zoom_level(factor.ln() / 1.2_f64.ln());
+            }
+        }
+    }
+
     fn host(&self) -> Option<BrowserHost> {
         self.browser.as_ref().and_then(|b| b.host())
     }
